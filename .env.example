# ---------------------------------------------------------------------------
# WedPlan client environment variables
# Copy this file to .env.local and fill in the values. Never commit real keys.
# ---------------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Database (shared with the Express API)
MONGODB_URI=
MONGODB_DB_NAME=wedplan

# Better Auth
BETTER_AUTH_SECRET=

# JWT bridge to the Express API (must match the server's JWT_SECRET)
JWT_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Express API
NEXT_PUBLIC_API_URL=
# Use fixture data until the Express API is available. Never enable in production.
NEXT_PUBLIC_USE_MOCK=false

# Stripe (checkout is created by the Express API)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Image hosting (server-side upload proxy only)
IMGBB_API_KEY=
